{
  "name": "@quno/datepicker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/quno-datepicker.js",
  "module": "./dist/quno-datepicker.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/quno-datepicker.js"
    },
    "./styles.css": "./dist/quno-datepicker.css"
  },
  "files": [
    "dist/quno-datepicker.js",
    "dist/quno-datepicker.css",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/components/QunoDatePicker.d.ts",
    "dist/components/QunoDatePicker.d.ts.map",
    "dist/components/datePickerTypes.d.ts",
    "dist/components/datePickerTypes.d.ts.map",
    "dist/components/dateRangeModel.d.ts",
    "dist/components/dateRangeModel.d.ts.map",
    "README.md",
    "CHANGELOG.md",
    "DECISIONS.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run check:file-size && npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "check:file-size": "node scripts/check-file-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx src tests",
    "report:size": "node scripts/report-size.mjs"
  },
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "preact": "^10.18.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/preact": "^3.2.4",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "@types/node": "^22.10.2",
    "eslint": "^8.48.0",
    "eslint-config-preact": "^1.3.0",
    "jsdom": "^26.0.0",
    "preact": "^10.18.1",
    "typescript": "^5.2.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.9"
  }
}
